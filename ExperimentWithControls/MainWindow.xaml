<Window x:Class="ExperimentWithControls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExperimentWithControls"
        mc:Ignorable="d"
        Title="Experiment With Controls" Height="450" Width="800">
    <!--linhas-->
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition />
            <RowDefinition Height=".5*"/>
        </Grid.RowDefinitions>
        <!--Coluna -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="53*"/>
            <ColumnDefinition Width="47*"/>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>
        <Label x:Name="Enter_a_number" Content="Enter a number" FontSize=" 18" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock x:Name="number" Grid.ColumnSpan="1" Text="#" FontSize="24"  HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" Grid.Column="2" Margin="210,107,0,0" PreviewTextInput="numberTextBox_PreviewTextInput" Width="180"/>
        <TextBox x:Name="numberTextBox" HorizontalAlignment="Left" Margin="10,61,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="120" FontSize="18" TextChanged="numberTextBox_TextChanged" PreviewTextInput="numberTextBox_PreviewTextInput" RenderTransformOrigin="0.513,0.719"/>
        <RadioButton Content="1" HorizontalAlignment="Left" Margin="164,49,0,0" VerticalAlignment="Top" Height="25" Width="41" Checked="RadioButton_Checked"/>
        <RadioButton Content="2" HorizontalAlignment="Left" Margin="210,50,0,0" VerticalAlignment="Top" Height="25" Width="41" RenderTransformOrigin="0.478,1.226" Grid.ColumnSpan="2" Checked="RadioButton_Checked_1"/>
        <RadioButton Content="3" HorizontalAlignment="Left" Margin="39,49,0,0" VerticalAlignment="Top" Height="25" Width="41" RenderTransformOrigin="0.478,1.226" Grid.Column="1" Checked="RadioButton_Checked_2"/>
        <RadioButton Content="4" HorizontalAlignment="Left" Margin="164,73,0,0" VerticalAlignment="Top" Height="25" Width="41" RenderTransformOrigin="0.478,1.226" Checked="RadioButton_Checked_3"/>
        <RadioButton Content="5" HorizontalAlignment="Left" Margin="210,73,0,0" VerticalAlignment="Top" Height="25" Width="41" RenderTransformOrigin="0.478,1.226" Grid.ColumnSpan="2" Checked="RadioButton_Checked_4"/>
        
        <ListBox x:Name="myListBox" Grid.Row="1" Margin="10,20,10,0" Grid.ColumnSpan="2" SelectionChanged="myListBox_SelectionChanged">
            <ListBoxItem Content="1"/>
            <ListBoxItem Content="2"/>
            <ListBoxItem Content="3"/>
            <ListBoxItem Content="4"/>
            <ListBoxItem Content="5"/>
        </ListBox>
        <ComboBox x:Name="readOnlyComboBox" 
                  HorizontalAlignment="Left" 
                  Margin="10,15,0,0" 
                  VerticalAlignment="Top"
                  Width="120" 
                  SelectionChanged="readOnlyComboBox_SelectionChanged"
                  Grid.Column="2"
                  Grid.Row="1">
            
            <ListBoxItem Content="1"/>
            <ListBoxItem Content="2"/>
            <ListBoxItem Content="3"/>
            <ListBoxItem Content="4"/>
            <ListBoxItem Content="5"/>
        </ComboBox>
        
        <ComboBox x:Name="EditableComboBox"
                  Grid.Column="2" 
                  Grid.Row="1"
                  IsEditable="True"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top" 
                  Width="120"
                  Margin="270,10,0,0" 
                  PreviewTextInput="numberTextBox_PreviewTextInput" 
                  TextBoxBase.TextChanged="EditableComboBox_TextChanged">
            
            <ListBoxItem Content="1"/>
            <ListBoxItem Content="2"/>
            <ListBoxItem Content="3"/>
            <ListBoxItem Content="4"/>
            <ListBoxItem Content="5"/>
        </ComboBox>
        <RadioButton Content="6" HorizontalAlignment="Left" Margin="39,73,0,0" VerticalAlignment="Top" Height="25" Width="41" RenderTransformOrigin="0.478,1.226" Grid.Column="1" Checked="RadioButton_Checked_5"/>
        <Slider x:Name="smallSlider" HorizontalAlignment="Left" Margin="10,143,0,0" VerticalAlignment="Top" Width="120" Height="25" ValueChanged="Slider_ValueChanged" AutoToolTipPlacement="TopLeft" Maximum="5" Minimum="1"/>
        <Slider x:Name="bigslider" HorizontalAlignment="Left" Margin="10,10,10,10" Grid.Row="2" VerticalAlignment="Top" Width="120" Grid.ColumnSpan="2" Maximum="9999999999" Minimum="1111111111" Value="7183876962" ValueChanged="bigslider_ValueChanged"/>
    </Grid>
</Window>
